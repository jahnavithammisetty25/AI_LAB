import heapq


def manhattan_distance(state, goal):

    distance = 0

    for tile in range(1, 9):

        current_position = state.index(tile)
        goal_position = goal.index(tile)

        current_row = current_position // 3
        current_col = current_position % 3

        goal_row = goal_position // 3
        goal_col = goal_position % 3

        distance += abs(current_row - goal_row)
        distance += abs(current_col - goal_col)

    return distance


def get_neighbors(state):

    neighbors = []

    zero = state.index(0)

    row = zero // 3
    col = zero % 3

    moves = [
        (-1, 0), # Up
        (1, 0), # Down
        (0, -1), # Left
        (0, 1) # Right
    ]

    for dr, dc in moves:

        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:

            new_zero = new_row * 3 + new_col

            new_state = list(state)

            new_state[zero], new_state[new_zero] = \
                new_state[new_zero], new_state[zero]

            neighbors.append(tuple(new_state))

    return neighbors


def print_state(state):

    for i in range(0, 9, 3):
        print(state[i:i+3])

    print()


def a_star(start, goal):

    # Priority Queue
    # (f, g, state)

    pq = []

    g = 0
    h = manhattan_distance(start, goal)
    f = g + h

    heapq.heappush(pq, (f, g, start))

    parent = {}
    cost = {start: 0}

    while pq:

        f, g, current = heapq.heappop(pq)

        if current == goal:

            path = []

            while current in parent:

                path.append(current)
                current = parent[current]

            path.append(start)

            path.reverse()

            print("Solution:")

            for state in path:
                print_state(state)

            print("Number of moves:", len(path) - 1)

            return

        for child in get_neighbors(current):

            new_g = g + 1

            if child not in cost or new_g < cost[child]:

                cost[child] = new_g

                h = manhattan_distance(child, goal)

                f = new_g + h

                parent[child] = current

                heapq.heappush(
                    pq,
                    (f, new_g, child)
                )

    print("No solution found.")


