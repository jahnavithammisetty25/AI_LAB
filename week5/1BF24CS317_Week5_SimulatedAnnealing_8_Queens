import math
import random

N = 8

def get_cost(board):
    
    conflicts = 0
    for i in range(N):
        for j in range(i + 1, N):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                conflicts += 1
    return conflicts

def get_random_neighbour(current):
    
    next_board = list(current)
    col = random.randint(0, N - 1)
    current_row = current[col]
    new_row = random.randint(0, N - 1)
    
    while new_row == current_row:
        new_row = random.randint(0, N - 1)
        
    next_board[col] = new_row
    return next_board

def simulated_annealing_with_trace():
   
    current = [random.randint(0, N - 1) for _ in range(N)]

    T = 50.0
    cooling_rate = 0.995
    step = 1

    print("=========================================================================")
    print("SIMULATED ANNEALING TRACE LOG (8-QUEENS)")
    print("=========================================================================")
    print(f"Step 0 (Initial State): {current} | Cost: {get_cost(current)}")
    print(f"Initial Temperature (T): {T}\n")

    
    while T > 0.0001:
        current_cost = get_cost(current)
        
        if current_cost == 0:
            print(f"Perfect solution discovered at Step {step - 1}")
            print(f"Final Configuration: {current}")
            return

 
        next_board = get_random_neighbour(current)
        next_cost = get_cost(next_board)

        
        delta_E = current_cost - next_cost

        
        if step <= 15:
            print(f"--- Step {step} ---")
            print(f" Current State: {current} (Cost: {current_cost})")
            print(f" Next State:    {next_board} (Cost: {next_cost})")
            print(f" ΔE Calculation: {current_cost} - {next_cost} = {delta_E}")
            print(f" Current Temp T: {T:.4f}")

        
        if delta_E > 0:
            if step <= 15:
                print("  ↳ Decision: ΔE > 0 (Better state found). Move accepted automatically!")
            current = next_board
       
        else:
            p = math.exp(delta_E / T)
            random_value = random.random()
            accepted = random_value < p

            if step <= 15:
                print("  ↳ Decision: ΔE <= 0 (Worse/Equal state). Calculating probability:")
                print(f"    Formula: p = e^({delta_E} / {T:.4f}) = {p:.6f}")
                status_str = "ACCEPTED anyway!" if accepted else "REJECTED. Staying put."
                print(f"    Random Roll vs Threshold: {random_value:.4f} < {p:.6f} -> {status_str}")

            if accepted:
                current = next_board

        if step <= 15:
            print()

        
        T *= cooling_rate;
        step += 1
        
    print(f"Search finished. Final Board State: {current} with {get_cost(current)} conflicts remaining.")

if __name__ == "__main__":
    simulated_annealing_with_trace()


